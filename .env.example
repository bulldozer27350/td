# ============================================================================
# .env.example — Variables d'environnement pour le déploiement local
# ============================================================================
#
# ⚠️  CE FICHIER EST UN MODÈLE. NE PAS MODIFIER CE FICHIER DIRECTEMENT.
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Modifier les valeurs dans .env selon ton environnement
#   3. Ne jamais commiter .env sur GitHub (secrets !)
#
# Le fichier .env est automatiquement lu par "docker-compose up".
# Docker remplace les variables ${NOM_VARIABLE} dans docker-compose.yml
# par les valeurs définies ici.
# ============================================================================

# ── Réseau et CORS ────────────────────────────────────────────────────────────
# Domaines autorisés à appeler les APIs (CORS).
# En développement : "*" (tous les domaines)
# En production : ton domaine exact, ex: "https://mondomaine.ddns.net"
CORS_ALLOWED_ORIGINS=*

# ── Profil Spring ─────────────────────────────────────────────────────────────
# "prod" active les configurations de production (logs réduits, pas de Swagger UI, etc.)
# "dev" active les configurations de développement (Swagger UI activé)
SPRING_PROFILES_ACTIVE=prod

# ── GitHub (utilisé par GitHub Actions, pas par docker-compose local) ────────
# Rempli automatiquement par GitHub Actions ou à configurer manuellement sur ton serveur
GITHUB_REPOSITORY=bulldozer27350/td
