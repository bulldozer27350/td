# ============================================================================
# .env.production — Configuration pour l'accès public (etourneau.ddns.net)
# ============================================================================

# ── RÉSEAU & SÉCURITÉ ────────────────────────────────────────────────────────
# Ton nom de domaine No-IP (sans http://)
DOMAIN=etourneau.ddns.net

# Autorise le frontend à parler au backend (Sécurité CORS)
CORS_ALLOWED_ORIGINS=http://etourneau.ddns.net

# ── DOCKER REGISTRY ──────────────────────────────────────────────────────────
# Chemin vers tes images publiées par GitHub Actions
IMAGE_PATH=ghcr.io/bulldozer27350/td

# ── STOCKAGE ──────────────────────────────────────────────────────────────────
# Chemin où sont stockés les fichiers de jeu sur ton PC
# "." signifie le dossier actuel (où se trouve docker-compose.yml)
TD_DATA_DIR=./exportables

# ── JAVA OPTIONS ─────────────────────────────────────────────────────────────
# Optimisation de la mémoire pour les petits serveurs
JAVA_OPTS=-Xms128m -Xmx512m
