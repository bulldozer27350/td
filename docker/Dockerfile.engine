# ============================================================================
# Dockerfile — td-engine-http (Moteur de jeu)
# ============================================================================
#
# Ce fichier utilise une construction en 2 étapes (multi-stage build) :
#
#   Étape 1 "builder" : compile le code Java avec Maven
#   Étape 2 "runtime" : copie uniquement le JAR final dans une image légère
#
# Avantage : l'image finale ne contient pas Maven, ni les sources Java.
# Taille typique : ~200 MB au lieu de ~600 MB.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# ÉTAPE 1 : Construction du JAR avec Maven
# ─────────────────────────────────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-21 AS builder

# Dossier de travail dans le conteneur de build
WORKDIR /build

# ── Optimisation du cache Docker ──────────────────────────────────────────────
# On copie d'abord uniquement les fichiers pom.xml de toute la hiérarchie.
# Ainsi, si seul du code source change (pas les dépendances), Docker réutilise
# le cache de l'étape "mvn dependency:go-offline" sans retélécharger Maven.
COPY pom.xml ./pom.xml

# Modules dont td-engine-http dépend directement ou indirectement
COPY td-engine/pom.xml                              td-engine/pom.xml
COPY td-engine/td-engine-api/pom.xml                td-engine/td-engine-api/pom.xml
COPY td-engine/td-engine-core/pom.xml               td-engine/td-engine-core/pom.xml
COPY td-engine/td-engine-http/pom.xml               td-engine/td-engine-http/pom.xml
COPY td-engine/td-engine-tests/pom.xml              td-engine/td-engine-tests/pom.xml

# Modules utilitaires partagés (td-config, td-exceptions, etc.)
# On les détecte en copiant tous les pom.xml qui pourraient exister
COPY td-runner/pom.xml                              td-runner/pom.xml
COPY td-console-viewer/pom.xml                      td-console-viewer/pom.xml

# Téléchargement des dépendances (mis en cache si les POM n'ont pas changé)
# -pl  : liste des modules à construire
# -am  : also-make (construit aussi les dépendances des modules listés)
RUN mvn dependency:go-offline \
      -pl td-engine/td-engine-http \
      -am \
      --no-transfer-progress \
      --batch-mode

# ── Copie du code source ───────────────────────────────────────────────────────
# On copie maintenant les sources (après le cache des dépendances)
COPY td-engine/       td-engine/
COPY td-runner/       td-runner/
COPY td-console-viewer/ td-console-viewer/

# ── Compilation ────────────────────────────────────────────────────────────────
# -DskipTests : on ne lance pas les tests ici (la CI s'en charge séparément)
RUN mvn package \
      -pl td-engine/td-engine-http \
      -am \
      -DskipTests \
      --no-transfer-progress \
      --batch-mode


# ─────────────────────────────────────────────────────────────────────────────
# ÉTAPE 2 : Image d'exécution finale (légère, sans Maven)
# ─────────────────────────────────────────────────────────────────────────────
# eclipse-temurin:21-jre-alpine = Java 21 JRE (pas JDK complet) sur Alpine Linux
# Alpine = distribution Linux minimaliste (~5 MB, très sécurisée)
FROM eclipse-temurin:21-jre-alpine

# Métadonnées de l'image (bonnes pratiques OCI)
LABEL org.opencontainers.image.title="Tower Defense — Moteur de jeu"
LABEL org.opencontainers.image.description="Service Spring Boot gérant les sessions de jeu"
LABEL org.opencontainers.image.source="https://github.com/bulldozer27350/td"

# Créer un utilisateur non-root pour la sécurité
# Ne jamais faire tourner une application en root dans un conteneur !
RUN addgroup -S tdgroup && adduser -S tduser -G tdgroup

WORKDIR /app

# Copier uniquement le JAR compilé depuis l'étape builder
# Le wildcard *.jar gère automatiquement le numéro de version dans le nom du JAR
COPY --from=builder /build/td-engine/td-engine-http/target/*.jar app.jar

# Changer le propriétaire du JAR vers l'utilisateur non-root
RUN chown tduser:tdgroup app.jar

# Basculer vers l'utilisateur non-root
USER tduser

# Port exposé (doit correspondre à server.port dans application.yml)
EXPOSE 8080

# Variables d'environnement par défaut (surchargeables au démarrage)
# Ces valeurs seront écrasées par les variables dans docker-compose.yml
ENV SPRING_PROFILES_ACTIVE=prod
ENV JAVA_OPTS="-Xms128m -Xmx512m"

# Commande de démarrage
# $JAVA_OPTS permet de passer des options JVM (-Xmx, -Xms, etc.) depuis l'extérieur
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
